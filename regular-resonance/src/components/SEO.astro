---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, any> | Record<string, any>[];
  canonicalUrl?: string;
}

const {
  title = 'Sazilo Store Blog — E-Commerce Website Builder Nepal',
  description = 'Explore expert e-commerce guides, online store strategies, Cloud POS tutorials, and digital commerce insights from verified Nepali merchants on Sazilo Store.',
  image = 'https://sazilostore.vritico.com/storage/platform/logo.webp',
  article,
  jsonLd,
  canonicalUrl,
} = Astro.props;

const siteName = 'Sazilo Store Blog';

// Compute absolute clean canonical URL (always https://blog.vritico.com)
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const computedCanonical = canonicalUrl || (pathname === '/' ? 'https://blog.vritico.com/' : `https://blog.vritico.com${pathname}`);

// Clean title and prevent duplicate suffixes
let cleanTitle = title.trim();
if (!cleanTitle.toLowerCase().includes('sazilo store')) {
  cleanTitle = `${cleanTitle} — Sazilo Store`;
}

// Clean description (ensuring optimal 140-160 character meta description for search engines)
let cleanDesc = (description || '').trim();
if (!cleanDesc) {
  cleanDesc = 'Explore expert e-commerce guides, retail strategies, and Cloud POS tutorials for building and scaling online businesses in Nepal with Sazilo Store.';
} else if (cleanDesc.length > 160) {
  cleanDesc = cleanDesc.slice(0, 157).replace(/\s+[^\s]*$/, '') + '...';
}

// Clean image URL (ensure no localhost leakage)
let ogImage = image;
if (ogImage.startsWith('http://localhost:1337') || ogImage.startsWith('http://127.0.0.1:1337')) {
  ogImage = ogImage.replace(/^http:\/\/(localhost|127\.0\.0\.1):1337/, 'https://cmsblog.vritico.com');
}
---

<!-- Performance & DNS Preconnect -->
<link rel="preconnect" href="https://cmsblog.vritico.com" crossorigin />
<link rel="dns-prefetch" href="https://cmsblog.vritico.com" />
<link rel="preconnect" href="https://sazilostore.vritico.com" crossorigin />
<link rel="dns-prefetch" href="https://sazilostore.vritico.com" />

<!-- Primary Meta Tags -->
<title>{cleanTitle}</title>
<meta name="title" content={cleanTitle} />
<meta name="description" content={cleanDesc} />
<meta name="keywords" content="Sazilo Store, SaziloStore, blog, ecommerce website builder nepal, nepali merchants, zero commission, cloud pos, vritico solutions, ecommerce guides" />
<meta name="author" content={article?.author || 'Sazilo Store'} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />
<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
<link rel="canonical" href={computedCanonical} />

<!-- RSS Feed Auto-Discovery -->
<link rel="alternate" type="application/rss+xml" title="Sazilo Store Blog RSS Feed" href="https://blog.vritico.com/rss.xml" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={computedCanonical} />
<meta property="og:title" content={cleanTitle} />
<meta property="og:description" content={cleanDesc} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={cleanTitle} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />

{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
{article?.author && <meta property="article:author" content={article.author} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={computedCanonical} />
<meta name="twitter:title" content={cleanTitle} />
<meta name="twitter:description" content={cleanDesc} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={cleanTitle} />
<meta name="twitter:site" content="@vritico" />
<meta name="twitter:creator" content="@vritico" />

<!-- Favicons & Icons -->
<link rel="icon" type="image/x-icon" href="/sazilo-favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="https://sazilostore.vritico.com/favicon-32x32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/sazilo-logo.webp" />

<!-- Structured Data (JSON-LD) -->
{jsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

<!-- Default Light Theme initialization script (prevents FOUC) -->
<script is:inline>
  (function() {
    var stored = localStorage.getItem('theme');
    if (stored === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  })();
</script>
