---
import { mediaUrl, calculateReadingTime, type Article } from '../../lib/strapi';

export interface Props {
  article: Article;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const cover = mediaUrl(article.cover);
const readTime = calculateReadingTime(article.blocks || article.description);
const authorAvatar = mediaUrl(article.author?.avatar);
const formattedDate = article.publishedAt
  ? new Date(article.publishedAt).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    })
  : 'Recent';
---

<article
  class={`group relative flex flex-col rounded-2xl border border-border/70 bg-card text-card-foreground shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-primary/50 overflow-hidden ${
    featured ? 'md:grid md:grid-cols-12 md:gap-6' : ''
  }`}
>
  <!-- Thumbnail Container -->
  <div
    class={`relative overflow-hidden bg-muted/40 shrink-0 ${
      featured ? 'md:col-span-6 h-64 md:h-full min-h-[260px]' : 'h-52 w-full aspect-video sm:aspect-auto'
    }`}
  >
    {cover ? (
      <img
        src={cover}
        alt={article.title}
        width="600"
        height="400"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-muted text-muted-foreground/60">
        <svg class="size-12" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
    )}

    {article.category && (
      <span class="absolute top-3.5 left-3.5 inline-flex items-center rounded-md bg-card px-2.5 py-0.5 text-[11px] font-semibold text-foreground border border-border tracking-wider">
        {article.category.name}
      </span>
    )}
  </div>

  <!-- Content Container -->
  <div class={`flex flex-1 flex-col justify-between p-5 sm:p-6 ${featured ? 'md:col-span-6 md:p-8' : ''}`}>
    <div>
      <!-- Meta Details -->
      <div class="flex items-center gap-3 text-xs text-muted-foreground mb-3">
        <span class="inline-flex items-center gap-1">
          <svg class="size-3.5 text-muted-foreground/70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={article.publishedAt}>{formattedDate}</time>
        </span>
        <span>•</span>
        <span class="inline-flex items-center gap-1">
          <svg class="size-3.5 text-muted-foreground/70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {readTime}
        </span>
      </div>

      <!-- Title -->
      <h3
        class={`font-bold tracking-tight text-foreground transition-colors group-hover:text-primary ${
          featured ? 'text-2xl sm:text-3xl leading-snug mb-3' : 'text-lg sm:text-xl leading-snug mb-2'
        }`}
      >
        <a href={`/blog/${article.slug}`} class="after:absolute after:inset-0">
          {article.title}
        </a>
      </h3>

      <!-- Excerpt -->
      {article.description && (
        <p class={`text-muted-foreground leading-relaxed line-clamp-2 ${featured ? 'text-base sm:line-clamp-3 mb-6' : 'text-sm mb-4'}`}>
          {article.description}
        </p>
      )}
    </div>

    <!-- Author & Read More Footer -->
    <div class="mt-4 flex items-center justify-between border-t border-border/50 pt-4 text-xs">
      <div class="flex items-center gap-2.5">
        {authorAvatar ? (
          <img src={authorAvatar} alt={article.author?.name || 'Author'} width="28" height="28" class="size-7 rounded-full object-cover ring-1 ring-border" />
        ) : (
          <div class="size-7 rounded-full bg-primary/15 text-primary font-bold flex items-center justify-center text-xs">
            {article.author?.name ? article.author.name.charAt(0).toUpperCase() : 'S'}
          </div>
        )}
        <span class="font-medium text-foreground/90">{article.author?.name || 'Sazilo Store'}</span>
      </div>

      <span class="inline-flex items-center gap-1 font-semibold text-primary group-hover:translate-x-0.5 transition-transform">
        Read
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </div>
</article>
