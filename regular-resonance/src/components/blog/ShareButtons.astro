---
export interface Props {
  title: string;
  url: string;
  description?: string;
}

const { title, url } = Astro.props;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);
---

<div class="flex items-center gap-2 flex-wrap" data-share-container>
  <span class="text-xs font-semibold text-muted-foreground mr-1">Share:</span>

  <!-- Twitter / X -->
  <a
    href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on X / Twitter"
    class="size-8.5 rounded-lg border border-border/80 bg-card hover:bg-primary/10 hover:border-primary/40 hover:text-primary flex items-center justify-center text-muted-foreground transition-colors shadow-2xs"
  >
    <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
  </a>

  <!-- LinkedIn -->
  <a
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on LinkedIn"
    class="size-8.5 rounded-lg border border-border/80 bg-card hover:bg-primary/10 hover:border-primary/40 hover:text-primary flex items-center justify-center text-muted-foreground transition-colors shadow-2xs"
  >
    <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2m1.4 9.74v-8.37H5.06v8.37h2.8z"/>
    </svg>
  </a>

  <!-- Facebook -->
  <a
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on Facebook"
    class="size-8.5 rounded-lg border border-border/80 bg-card hover:bg-primary/10 hover:border-primary/40 hover:text-primary flex items-center justify-center text-muted-foreground transition-colors shadow-2xs"
  >
    <svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
    </svg>
  </a>

  <!-- Copy Link -->
  <button
    type="button"
    data-copy-url={url}
    aria-label="Copy link to clipboard"
    class="copy-link-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border/80 bg-card hover:bg-primary/10 hover:border-primary/40 hover:text-primary text-xs font-semibold text-muted-foreground transition-colors shadow-2xs cursor-pointer"
  >
    <svg class="size-3.5 copy-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
    </svg>
    <svg class="size-3.5 check-icon hidden text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span class="btn-text">Copy link</span>
  </button>
</div>

<script>
  function setupShareButtons() {
    document.querySelectorAll('.copy-link-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-copy-url') || window.location.href;
        navigator.clipboard.writeText(url).then(() => {
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          const text = btn.querySelector('.btn-text');
          if (copyIcon && checkIcon && text) {
            copyIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');
            text.textContent = 'Copied!';
            setTimeout(() => {
              copyIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
              text.textContent = 'Copy link';
            }, 2000);
          }
        });
      });
    });
  }
  setupShareButtons();
  document.addEventListener('astro:after-swap', setupShareButtons);
</script>
