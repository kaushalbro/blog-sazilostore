---
---

<section class="relative my-16 sm:my-24 rounded-3xl border border-border bg-card p-8 sm:p-12 lg:p-14 shadow-xs">
  <div class="max-w-2xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 rounded-md bg-muted px-3 py-1 text-xs font-semibold text-primary border border-border mb-4">
      <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      Sazilo Store Weekly Digest
    </div>

    <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-foreground mb-4">
      Stay ahead with stories that matter
    </h3>
    <p class="text-muted-foreground text-sm sm:text-base leading-relaxed mb-8">
      Get hand-picked articles on technology, authentic marketplace trends, lifestyle, and direct commerce stories delivered straight to your inbox. No spam, unsubscribe anytime.
    </p>

    <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
      <div class="relative flex-1">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
        </svg>
        <input
          type="email"
          required
          placeholder="Enter your email address"
          class="w-full rounded-xl border border-border bg-background px-4 py-3 pl-10 text-sm text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-hidden focus:ring-2 focus:ring-primary/20 transition-all shadow-xs"
        />
      </div>
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-xs hover:bg-primary/90 transition-colors cursor-pointer shrink-0"
      >
        Subscribe
        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </form>

    <div id="newsletter-success" class="hidden rounded-xl bg-muted border border-border p-4 text-sm font-medium text-primary">
      Thank you for subscribing to Sazilo Store Blog! Check your inbox soon.
    </div>

    <div class="flex items-center justify-center gap-6 mt-6 text-xs text-muted-foreground">
      <span class="flex items-center gap-1.5">
        <svg class="size-3.5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Free forever
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="size-3.5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Weekly curation
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="size-3.5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        No spam
      </span>
    </div>
  </div>
</section>

<script>
  function setupNewsletterForm() {
    const form = document.getElementById('newsletter-form');
    const successMsg = document.getElementById('newsletter-success');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('hidden');
      successMsg?.classList.remove('hidden');
    });
  }
  setupNewsletterForm();
  document.addEventListener('astro:after-swap', setupNewsletterForm);
</script>
