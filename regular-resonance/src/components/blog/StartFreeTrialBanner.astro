---
export interface Props {
  title?: string;
  subtitle?: string;
  compact?: boolean;
}

const {
  title = "Explore Conversion-Ready Store Templates",
  subtitle = "Experience pre-built storefronts designed for Fashion, Luxury Jewelry, Electronics, Groceries, and D2C brands.",
  compact = false,
} = Astro.props;
---

<section class="relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] w-screen max-w-[100vw] my-10 sm:my-14 border-y border-border bg-card overflow-hidden">
  <div class={`max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 ${compact ? 'py-6 sm:py-8' : 'py-8 sm:py-12'}`}>
    <!-- Main Flex Row: Large Storefront Icon, Title, Subtitle, and View Templates Action -->
    <div class="flex flex-col lg:flex-row items-center justify-between gap-6 lg:gap-10">
      <div class="flex items-center gap-4 sm:gap-6 text-center lg:text-left flex-col sm:flex-row flex-1">
        <div class="size-16 sm:size-20 rounded-2xl bg-muted text-primary flex items-center justify-center shrink-0 border border-border shadow-xs">
          <svg class="size-9 sm:size-11" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <div>
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-black tracking-tight text-foreground mb-1.5">
            {title}
          </h2>
          <p class="text-xs sm:text-sm lg:text-base text-muted-foreground max-w-2xl leading-relaxed">
            {subtitle}
          </p>
        </div>
      </div>

      <!-- Direct View Templates Button -->
      <a
        href="https://sazilostore.vritico.com/#templates"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl border border-primary/40 bg-card hover:bg-primary/10 text-primary font-bold text-sm sm:text-base shadow-xs transition-colors cursor-pointer shrink-0"
      >
        <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span>View Live Demo Templates ↗</span>
      </a>
    </div>

    <!-- Quick Template Chips (Text-only design) -->
    <div class="mt-6 pt-5 border-t border-border flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs">
      <span class="text-muted-foreground font-semibold">Demo Categories:</span>
      <a href="https://sazilostore.vritico.com/#templates" target="_blank" rel="noopener noreferrer" class="px-3.5 py-1.5 rounded-lg border border-border bg-muted/60 hover:bg-muted text-foreground hover:text-primary font-semibold transition-colors">Fashion &amp; Lifestyle</a>
      <a href="https://sazilostore.vritico.com/#templates" target="_blank" rel="noopener noreferrer" class="px-3.5 py-1.5 rounded-lg border border-border bg-muted/60 hover:bg-muted text-foreground hover:text-primary font-semibold transition-colors">Jewelry &amp; Luxury</a>
      <a href="https://sazilostore.vritico.com/#templates" target="_blank" rel="noopener noreferrer" class="px-3.5 py-1.5 rounded-lg border border-border bg-muted/60 hover:bg-muted text-foreground hover:text-primary font-semibold transition-colors">Tech &amp; Gadgets</a>
      <a href="https://sazilostore.vritico.com/#templates" target="_blank" rel="noopener noreferrer" class="px-3.5 py-1.5 rounded-lg border border-border bg-muted/60 hover:bg-muted text-foreground hover:text-primary font-semibold transition-colors">Organic Himalayan Products</a>
    </div>

    <!-- Big Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-6 mb-6">
      <a
        href="https://sazilostore.vritico.com/register"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 rounded-xl bg-primary px-9 py-4 text-base font-bold text-primary-foreground shadow-xs hover:bg-primary/90 transition-colors cursor-pointer"
      >
        <span>Start 14-Day Free Trial</span>
        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href="https://sazilostore.vritico.com/#templates"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-muted hover:bg-muted/80 px-8 py-4 text-sm sm:text-base font-bold text-foreground shadow-xs transition-colors cursor-pointer"
      >
        <svg class="size-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Explore All Features</span>
      </a>
    </div>

    <!-- Feature Badges -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-semibold text-foreground/90 border-t border-border pt-5">
      <div class="flex items-center justify-center gap-1.5">
        <svg class="size-4 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>0% Platform Commission</span>
      </div>
      <div class="flex items-center justify-center gap-1.5">
        <svg class="size-4 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Cloud POS (&lt;15ms F2/F9)</span>
      </div>
      <div class="flex items-center justify-center gap-1.5">
        <svg class="size-4 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Code128 Barcode Studio</span>
      </div>
      <div class="flex items-center justify-center gap-1.5">
        <svg class="size-4 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Direct WhatsApp Connect</span>
      </div>
    </div>
  </div>
</section>
