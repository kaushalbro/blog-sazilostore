---
import { mediaUrl } from '../../lib/strapi';

export interface Props {
  author?: {
    id?: number;
    name?: string;
    email?: string;
    avatar?: any;
    [key: string]: any;
  } | null;
  articleCount?: number;
}

const { author, articleCount } = Astro.props;
const avatar = mediaUrl(author?.avatar);
---

<div class="flex items-start gap-4 p-6 rounded-2xl border border-border/70 bg-card text-card-foreground shadow-xs">
  {avatar ? (
    <img src={avatar} alt={author?.name || 'Author'} width="56" height="56" loading="lazy" decoding="async" class="size-14 rounded-full object-cover ring-2 ring-primary/20 shrink-0" />
  ) : (
    <div class="size-14 rounded-full bg-primary/15 text-primary font-bold text-xl flex items-center justify-center ring-2 ring-primary/20 shrink-0">
      {author?.name ? author.name.charAt(0).toUpperCase() : 'S'}
    </div>
  )}

  <div class="flex-1 min-w-0">
    <div class="flex items-center justify-between gap-2 mb-1">
      <h4 class="font-bold text-base text-foreground">{author?.name || 'Sazilo Store Editorial Team'}</h4>
      {typeof articleCount === 'number' && (
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-muted text-muted-foreground font-medium">
          {articleCount} {articleCount === 1 ? 'article' : 'articles'}
        </span>
      )}
    </div>
    <p class="text-xs text-primary font-medium mb-2">Verified Contributor • Sazilo Store</p>
    <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
      Passionate writer exploring modern commerce, marketplace trends, technology, lifestyle, and authentic local products.
    </p>
  </div>
</div>
