---
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border/70 bg-background/85 backdrop-blur-md transition-colors">
  <div class="mx-auto flex max-w-screen-2xl items-center justify-between px-4 sm:px-6 lg:px-10 h-16">
    <!-- Brand Logo & Name -->
    <div class="flex items-center gap-3 sm:gap-6 min-w-0 shrink">
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0" aria-label="Sazilo Store Blog">
        <img
          src="/sazilo-logo.webp"
          alt="Sazilo Store"
          width="160"
          height="32"
          class="h-7 sm:h-8 w-auto object-contain transition-transform group-hover:scale-105"
        />
        <div class="flex flex-col">
          <span class="text-base sm:text-xl font-black tracking-tight text-foreground group-hover:text-primary transition-colors leading-tight">
            Sazilo Store
          </span>
          <span class="text-[9px] sm:text-[10px] font-bold tracking-wider uppercase text-primary leading-tight">
            Blog & Stories
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 pl-4 border-l border-border/60">
        <a
          href="/"
          class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
            currentPath === '/' ? 'text-primary bg-primary/10 font-semibold' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'
          }`}
        >
          Home
        </a>
        <a
          href="/blog"
          class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
            currentPath.startsWith('/blog') ? 'text-primary bg-primary/10 font-semibold' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'
          }`}
        >
          All Articles
        </a>
        <a
          href="/categories"
          class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
            currentPath.startsWith('/categor') ? 'text-primary bg-primary/10 font-semibold' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'
          }`}
        >
          Categories
        </a>
        <a
          href="/about"
          class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
            currentPath === '/about' ? 'text-primary bg-primary/10 font-semibold' : 'text-muted-foreground hover:text-foreground hover:bg-muted/60'
          }`}
        >
          About
        </a>
      </nav>
    </div>

    <!-- Right Controls: Demo Shops / Start Free Trial / Theme / Mobile Menu -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href="https://sazilostore.vritico.com/#templates"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-1.5 rounded-xl border border-border/80 bg-card px-3 py-1.5 text-xs font-semibold text-foreground hover:border-primary/40 hover:text-primary transition-all shadow-2xs"
      >
        <svg class="size-3.5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span>Demo Shops</span>
      </a>

      <!-- Start Free Trial: hidden on small mobile to avoid header collision; available full-width in hamburger dropdown -->
      <a
        href="https://sazilostore.vritico.com/register"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-xl bg-primary px-3.5 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition-colors cursor-pointer shrink-0"
      >
        <span>Start Free Trial</span>
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <div class="h-5 w-px bg-border/80 hidden sm:block" />

      <ThemeToggle />

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden inline-flex size-9 items-center justify-center rounded-lg border border-border bg-card text-foreground hover:bg-muted transition-colors shrink-0"
        aria-label="Open mobile navigation menu"
      >
        <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border/70 bg-card px-4 py-4 space-y-2 shadow-lg">
    <a
      href="/"
      class={`block px-3 py-2 rounded-lg text-sm font-medium ${
        currentPath === '/' ? 'bg-primary/10 text-primary font-bold' : 'text-foreground hover:bg-muted'
      }`}
    >
      Home
    </a>
    <a
      href="/blog"
      class={`block px-3 py-2 rounded-lg text-sm font-medium ${
        currentPath.startsWith('/blog') ? 'bg-primary/10 text-primary font-bold' : 'text-foreground hover:bg-muted'
      }`}
    >
      All Articles
    </a>
    <a
      href="/categories"
      class={`block px-3 py-2 rounded-lg text-sm font-medium ${
        currentPath.startsWith('/categor') ? 'bg-primary/10 text-primary font-bold' : 'text-foreground hover:bg-muted'
      }`}
    >
      Categories
    </a>
    <a
      href="/about"
      class={`block px-3 py-2 rounded-lg text-sm font-medium ${
        currentPath === '/about' ? 'bg-primary/10 text-primary font-bold' : 'text-foreground hover:bg-muted'
      }`}
    >
      About Publication
    </a>
    <div class="pt-3 mt-2 border-t border-border/60 space-y-2">
      <a
        href="https://sazilostore.vritico.com/#templates"
        target="_blank"
        rel="noopener noreferrer"
        class="block px-3 py-2 rounded-xl text-sm font-semibold text-foreground bg-muted/60 text-center hover:bg-primary/15 hover:text-primary transition-colors"
      >
        Explore Live Demo Shops ↗
      </a>
      <a
        href="https://sazilostore.vritico.com/register"
        target="_blank"
        rel="noopener noreferrer"
        class="block px-3 py-2.5 rounded-xl text-sm font-bold text-primary-foreground bg-primary text-center shadow-md shadow-primary/20 hover:bg-primary/90 transition-all"
      >
        Start 14-Day Free Trial ↗
      </a>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
  }
  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
