---
import { getCategories } from '../lib/strapi';

let categories: any[] = [];
try {
  categories = await getCategories();
} catch {
  categories = [];
}
---

<footer class="border-t border-border/70 bg-card text-card-foreground mt-auto">
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Brand & Mission (4 cols) -->
      <div class="lg:col-span-4 flex flex-col justify-between">
        <div>
          <a href="/" class="inline-flex items-center gap-2.5 mb-4 group" aria-label="Sazilo Store Blog Home">
            <img src="/sazilo-logo.webp" alt="Sazilo Store Logo" width="160" height="32" class="h-8 w-auto object-contain transition-transform group-hover:scale-105" />
            <div class="flex flex-col">
              <span class="text-xl font-extrabold tracking-tight text-foreground group-hover:text-primary transition-colors">
                Sazilo Store
              </span>
              <span class="text-[10px] font-semibold tracking-widest uppercase text-muted-foreground -mt-1">
                by Vritico Solutions
              </span>
            </div>
          </a>
          <p class="text-sm text-muted-foreground leading-relaxed max-w-sm mb-4">
            We build and run business software from Bhaktapur, Nepal. Sazilo Store empowers local retailers with 0% sales commission, integrated Cloud POS, and automated commerce.
          </p>
          <div class="flex flex-wrap items-center gap-2.5 mb-6">
            <a
              href="https://sazilostore.vritico.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-primary/10 hover:bg-primary/20 text-primary text-xs font-semibold transition-colors border border-primary/20"
            >
              Visit Sazilo Store ↗
            </a>
            <a
              href="https://www.vritico.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-muted hover:bg-muted/80 text-foreground text-xs font-semibold transition-colors border border-border"
            >
              Vritico Website ↗
            </a>
          </div>
          <!-- Social Profiles -->
          <div class="flex items-center gap-3 text-muted-foreground mb-4">
            <a href="https://www.facebook.com/vriticosolutions" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="p-2 rounded-lg bg-muted/60 hover:bg-primary hover:text-primary-foreground transition-all">
              <svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://www.instagram.com/vriticosolutions" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="p-2 rounded-lg bg-muted/60 hover:bg-primary hover:text-primary-foreground transition-all">
              <svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/vritico-solutions" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="p-2 rounded-lg bg-muted/60 hover:bg-primary hover:text-primary-foreground transition-all">
              <svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
            <a href="https://youtube.com/@vriticosolutions" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="p-2 rounded-lg bg-muted/60 hover:bg-primary hover:text-primary-foreground transition-all">
              <svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
