            <a href="https://x.com/vritico" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="p-2 rounded-lg bg-muted/60 hover:bg-primary hover:text-primary-foreground transition-all">
              <svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Products & Ecosystem (3 cols) -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-foreground mb-4">Products &amp; Ecosystem</h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="https://sazilostore.vritico.com" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
              Sazilo.store (E-Commerce)
            </a>
          </li>
          <li>
            <a href="https://sazilostore.vritico.com/#showcase" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
              Smart Cloud POS
            </a>
          </li>
          <li>
            <a href="https://www.vritico.com" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
              ERP Suite
            </a>
          </li>
          <li>
            <a href="https://www.vritico.com" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
              Consultancy Management System
            </a>
          </li>
          <li>
            <a href="https://www.vritico.com" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
              Vritico Website Builder
            </a>
          </li>
          <li>
            <a href="https://www.vritico.com" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
              Social by Vritico
            </a>
          </li>
        </ul>
      </div>

      <!-- Categories / Navigation (2 cols) -->
      <div class="lg:col-span-2">
        <div class="flex items-center justify-between mb-4">
          <h4 class="text-xs font-bold uppercase tracking-widest text-foreground">Categories</h4>
          <a href="/categories" class="text-[11px] font-semibold text-primary hover:underline">All →</a>
        </div>
        <ul class="space-y-2.5 text-sm">
          {categories.slice(0, 6).map((cat) => (
            <li>
              <a href={`/category/${cat.slug}`} class="text-muted-foreground hover:text-primary transition-colors capitalize">
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Stay Connected & Contact Details (3 cols) -->
      <div class="lg:col-span-3">
        <h4 class="text-xs font-bold uppercase tracking-widest text-foreground mb-4">Stay Connected</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a
