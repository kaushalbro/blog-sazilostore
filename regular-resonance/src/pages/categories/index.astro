---
import "../../styles/global.css";
import Toolbar from "../../components/Toolbar.astro";
import Footer from "../../components/Footer.astro";
import SEO from "../../components/SEO.astro";
import StartFreeTrialBanner from "../../components/blog/StartFreeTrialBanner.astro";
import NewsletterCTA from "../../components/blog/NewsletterCTA.astro";
import { getCategories, getArticles, type Category, type Article } from "../../lib/strapi";

let categories: Category[] = [];
let articles: Article[] = [];

try {
  const [fetchedCats, fetchedArts] = await Promise.all([
    getCategories(),
    getArticles(),
  ]);
  categories = fetchedCats;
  articles = fetchedArts;
} catch {
  categories = [];
  articles = [];
}

const categoriesWithArticles = categories.map((cat) => {
  const catArticles = articles.filter(
    (a) =>
      a.category?.slug === cat.slug ||
      a.category?.name?.toLowerCase() === cat.name.toLowerCase()
  );
  return {
    ...cat,
    count: catArticles.length,
    recentArticles: catArticles.slice(0, 3),
  };
});

const pageTitle = "All E-Commerce Topics & Categories — Sazilo Store";
const pageDescription = "Explore curated e-commerce categories on Sazilo Store Blog, covering digital payments, courier logistics, Cloud POS, store marketing, and merchant growth.";

const canonicalUrl = "https://blog.vritico.com/categories";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": canonicalUrl,
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": categories.map((cat, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "url": `https://blog.vritico.com/category/${cat.slug}`,
        "name": cat.name,
        "description": cat.description
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://blog.vritico.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Categories",
        "item": canonicalUrl
      }
    ]
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle}
      description={pageDescription}
      canonicalUrl={canonicalUrl}
      jsonLd={jsonLd}
    />
  </head>

  <body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-primary/20 selection:text-primary">
    <Toolbar />

    <main class="flex-1 max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-10 py-8 sm:py-14 w-full">
      <!-- ── Breadcrumb ── -->
      <nav class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs text-muted-foreground mb-6 leading-normal" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors shrink-0 whitespace-nowrap">Home</a>
        <span class="text-border shrink-0">/</span>
        <span class="text-foreground font-semibold shrink-0 whitespace-nowrap">Categories</span>
      </nav>

      <!-- ── Header ── -->
      <header class="mb-12 border-b border-border/70 pb-8">
        <div class="inline-flex items-center rounded-md bg-muted px-3 py-1 text-primary text-xs font-semibold uppercase tracking-wider mb-3 border border-border">
          Topic Directory
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-foreground mb-3">
          Explore by Topic &amp; Category
        </h1>
        <p class="text-muted-foreground text-sm sm:text-lg max-w-2xl leading-relaxed">
          Deep-dive into specialized articles covering Nepal's e-commerce ecosystem, digital payment integrations, courier logistics, and direct store growth.
        </p>
      </header>

      <!-- ── Categories Grid ── -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {categoriesWithArticles.map((cat) => (
          <div class="group relative flex flex-col justify-between rounded-3xl border border-border bg-card p-6 sm:p-8 shadow-xs hover:border-primary/50 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex size-10 items-center justify-center rounded-xl bg-muted text-foreground font-black text-lg border border-border">
                  {cat.name.charAt(0)}
                </span>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-md bg-muted text-foreground border border-border">
                  {cat.count} {cat.count === 1 ? 'article' : 'articles'}
                </span>
              </div>

              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground group-hover:text-primary transition-colors mb-2">
                <a href={`/category/${cat.slug}`} class="after:absolute after:inset-0">
                  {cat.name}
                </a>
              </h2>

              {cat.description && (
                <p class="text-sm text-muted-foreground leading-relaxed mb-6">
                  {cat.description}
                </p>
              )}

              {cat.recentArticles.length > 0 && (
                <div class="border-t border-border/50 pt-4 mb-4 space-y-2 relative z-10">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground mb-2">Recent Stories:</p>
                  {cat.recentArticles.map((art) => (
                    <a
                      href={`/blog/${art.slug}`}
                      class="block text-xs font-medium text-foreground hover:text-primary transition-colors truncate"
                    >
                      • {art.title}
                    </a>
                  ))}
                </div>
              )}
            </div>

            <div class="border-t border-border/60 pt-4 flex items-center justify-between text-xs font-bold text-primary group-hover:translate-x-1 transition-transform">
              <span>View All {cat.name}</span>
              <svg class="size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        ))}
      </div>

      <!-- ── Big Start Free Trial & Demo Showcase Banner ── -->
      <StartFreeTrialBanner />

      <NewsletterCTA />
    </main>

    <Footer />
  </body>
</html>
